<?xml version="1.0" encoding="UTF-8"?>
<!-- Append a day header to ~/Documents/journal.md at 6am ("## Friday 29 May
     2026") so the day has a clean section to write under. Routes through the
     shared journal module (scripts/journal.sh stamp) — the same code path as
     manual `note` entries, so formatting stays consistent. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dotfiles.daily-journal</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-c</string>
        <string>"$HOME/code/dotfiles/scripts/journal.sh" stamp</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/dotfiles.daily-journal.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/dotfiles.daily-journal.log</string>
</dict>
</plist>
