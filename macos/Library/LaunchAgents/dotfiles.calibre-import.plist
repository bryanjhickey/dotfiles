<?xml version="1.0" encoding="UTF-8"?>
<!-- Watch ~/Downloads and ~/Documents/Digital Editions/ for ebook files
     and pipe them through scripts/inbox-to-calibre.sh into Calibre's
     library. Triggered by file additions in either directory. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dotfiles.calibre-import</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-c</string>
        <string>"$HOME/code/dotfiles/scripts/inbox-to-calibre.sh" "$HOME/Downloads" "$HOME/Documents/Digital Editions"</string>
    </array>
    <key>WatchPaths</key>
    <array>
        <string>/Users/bryanhickey/Downloads</string>
        <string>/Users/bryanhickey/Documents/Digital Editions</string>
    </array>
    <key>StandardOutPath</key>
    <string>/tmp/dotfiles.calibre-import.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/dotfiles.calibre-import.log</string>
</dict>
</plist>
